# Haleman env — copy to .env (NEVER commit .env)
APP_PORT=80
GUNICORN_WORKERS=3
POSTGRES_DB=haleman
POSTGRES_USER=haleman
POSTGRES_PASSWORD=change-me
# Compose uses db:5432 by default; override only for a nonstandard deployment.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Set to 1 behind HTTPS; keep 0 for local HTTP development.
COOKIE_SECURE=0
DJANGO_SECRET_KEY=change-me-50-chars-min
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LLM_PROVIDER=
LLM_API_KEY=
LLM_CHAT_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=haleman <noreply@example.com>
